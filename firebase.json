{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "tests/**",
      "**/*.md",
      "**/*.docx",
      "package.json",
      "package-lock.json",
      "asset-lab/**",
      "*.test.*"
    ],
    "cleanUrls": false
  }
}
